{
  "name": "supplykit",
  "build": {
    "command": "npm --prefix frontend run build",
    "cwd": "frontend"
  },
  "cloudFunctions": {
    "maxDuration": 120,
    "regions": {
      "mainland": ["ap-guangzhou"],
      "overseas": ["ap-singapore"]
    },
    "includeFiles": [
      "backend/app/**/*.py",
      "backend/app/**/*.json"
    ]
  }
}
