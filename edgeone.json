{
  "name": "supplykit",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "cloudFunctions": {
    "maxDuration": 120,
    "regions": {
      "mainland": ["ap-guangzhou"],
      "overseas": ["ap-singapore"]
    },
    "includeFiles": [
      "backend/app/**/*.py",
      "backend/app/**/*.json"
    ]
  }
}
