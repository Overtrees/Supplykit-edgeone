#!/bin/sh
# 推送前门禁(快检): 仅本次改动文件 eslint+prettier(秒级); 全量 tsc 由 CI/本地手动兜底
cd "$(dirname "$0")/.." || exit 1
CHANGED=$(git diff --name-only HEAD 2>/dev/null | grep -E '^frontend/src/.*\.(ts|tsx)$')
if [ -n "$CHANGED" ]; then
  FILES=$(echo "$CHANGED" | sed 's|^frontend/||')
  (cd frontend && npx eslint $FILES --max-warnings 0) || { echo "❌ eslint 失败——修复后再推送"; exit 1; }
  (cd frontend && npx prettier --check $FILES) || { echo "❌ prettier 失败——修复后再推送"; exit 1; }
else
  echo "无前端 src 改动, 门禁跳过"
fi
