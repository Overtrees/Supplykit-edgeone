# SupplyKit 本地开发环境变量模板
# 用法: cp .env.example .env 后填入真实值; .env 已在 .gitignore, 不会入库
# 校验: python3 scripts/env_check.py

# ── TiDB Serverless(本地直连 scripts/local_api.py 用) ──
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB=supplykit
TIDB_SSL=true

# ── 应用密钥 ──
# 本地回归/直连可留空(脚本自带 local-test-secret 兜底); 线上必须配置
JWT_SECRET=
# 定时任务鉴权; 线上建议必配, 未配时 cron 仅依赖平台 q-sign 保护
CRON_SECRET=
